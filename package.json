{
  "name": "notesnook-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Local MCP server acting as a headless Notesnook client (self-hosted sync server)",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "bin": {
    "notesnook-mcp": "dist/cli.js"
  },
  "scripts": {
    "vendor": "bash scripts/setup-vendor.sh",
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "login": "node dist/cli.js login",
    "sync": "node dist/cli.js sync",
    "start": "node dist/cli.js serve",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@napi-rs/keyring": "^2.1.0",
    "@notesnook/core": "file:vendor/notesnook/packages/core",
    "@notesnook/crypto": "file:vendor/notesnook/packages/crypto",
    "@streetwriters/kysely": "^0.27.4",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "event-source-polyfill": "^1.0.31",
    "linkedom": "^0.18.13",
    "marked": "^18.1.0",
    "sqlite-better-trigram": "^0.0.6",
    "sqlite-regex": "^0.2.4-alpha.1",
    "sqlite3-fts5-html": "^0.0.6",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  }
}
